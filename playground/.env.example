# ThunderID server. A local server listens on https://localhost:8090.
# From the Android emulator, the host machine is 10.0.2.2: https://10.0.2.2:8090
THUNDERID_BASE_URL=https://localhost:8090

# Application ID used by the app-native (Flow Execution API) sign-in and sign-up flows.
THUNDERID_APP_ID=your-application-id

# Optional. OAuth client ID and redirect URIs for the redirect-based (system browser) sign-in.
# Leave empty to run the playground with app-native flows only.
THUNDERID_CLIENT_ID=
THUNDERID_AFTER_SIGN_IN_URL=dev.thunderid.playground://callback
THUNDERID_AFTER_SIGN_OUT_URL=dev.thunderid.playground://signout

# Platform attestation (Apple App Attest / Google Play Integrity). Keep false for simulators,
# emulators, and applications that have attestation devMode enabled.
THUNDERID_ATTESTATION_ENABLED=false
THUNDERID_CLOUD_PROJECT_NUMBER=

# Optional. Scopes requested at sign-in, space separated. Management checks and the Admin
# components need the server's admin permissions in the access token, e.g. add `system`.
THUNDERID_SCOPES=openid profile email

# Optional. Organization unit used by the Admin create components (GroupCreate, RoleCreate,
# UserCreate, AgentCreate). Defaults to the signed-in user's `ouId` claim.
THUNDERID_OU_ID=

# Optional. Per-collection management endpoint overrides. Each becomes an entry of
# ThunderIDConfig.endpoints. Leave all empty to resolve every collection under THUNDERID_BASE_URL.
THUNDERID_ENDPOINT_USERS=
THUNDERID_ENDPOINT_USER_TYPES=
THUNDERID_ENDPOINT_GROUPS=
THUNDERID_ENDPOINT_ROLES=
THUNDERID_ENDPOINT_AGENTS=
THUNDERID_ENDPOINT_AGENT_TYPES=
